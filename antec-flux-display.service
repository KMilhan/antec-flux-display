[Unit]
Description=Antec Flux Pro Display Temperature Service
After=multi-user.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/antec-flux-display/antec-flux-display.py
Restart=on-failure
RestartSec=5

# Security hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

# Allow USB HID access
SupplementaryGroups=plugdev

[Install]
WantedBy=multi-user.target
